{
  "name": "commitboard",
  "displayName": "CommitBoard",
  "description": "A simple task board for teams inside VS Code. Plan sprints, assign tasks, link commits to tasks, and post progress updates.",
  "version": "0.3.0",
  "publisher": "AryanDevTools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aryan8451/teamboard.git"
  },
  "bugs": {
    "url": "https://github.com/Aryan8451/teamboard/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1b3a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitboard",
          "title": "CommitBoard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "commitboard": [
        {
          "type": "webview",
          "id": "commitboard.sidebar",
          "name": "My Work"
        }
      ]
    },
    "commands": [
      {
        "command": "commitboard.openBoard",
        "title": "Open Board",
        "category": "CommitBoard",
        "icon": "$(project)"
      },
      {
        "command": "commitboard.openTeam",
        "title": "Open Contributors & Leaderboard",
        "category": "CommitBoard",
        "icon": "$(organization)"
      },
      {
        "command": "commitboard.newTask",
        "title": "New Task",
        "category": "CommitBoard",
        "icon": "$(add)"
      },
      {
        "command": "commitboard.logWork",
        "title": "Add Update (non-code work: marketing, design, meetings...)",
        "category": "CommitBoard",
        "icon": "$(note)"
      },
      {
        "command": "commitboard.setCurrentTask",
        "title": "Set Current Task",
        "category": "CommitBoard"
      },
      {
        "command": "commitboard.linkLastCommit",
        "title": "Link / Change Task of Last Commit",
        "category": "CommitBoard"
      },
      {
        "command": "commitboard.refresh",
        "title": "Refresh",
        "category": "CommitBoard",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "commitboard.openBoard",
          "when": "view == commitboard.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "commitboard.newTask",
          "when": "view == commitboard.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "commitboard.refresh",
          "when": "view == commitboard.sidebar",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "CommitBoard",
      "properties": {
        "commitboard.commitPrompt": {
          "type": "string",
          "enum": [
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask which task each of your new commits belongs to (unless the message already contains a task tag like [T-AB12]).",
            "Never prompt. Commits can still be linked with a tag in the message or via 'Link Last Commit'."
          ],
          "default": "always",
          "description": "When to show the 'What was this commit for?' window."
        },
        "commitboard.promptOnPush": {
          "type": "boolean",
          "default": true,
          "description": "After a push, offer to link any of your pushed commits that are not linked to a task yet."
        },
        "commitboard.autoTagCommitMessage": {
          "type": "boolean",
          "default": true,
          "description": "Pre-fill the Source Control commit box with your current task tag, e.g. [T-AB12]."
        },
        "commitboard.maxCommits": {
          "type": "number",
          "default": 5000,
          "description": "Maximum number of commits read from git history for contributor statistics."
        },
        "commitboard.excludeFromLineStats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "package-lock.json",
            "yarn.lock",
            "pnpm-lock.yaml",
            "*.min.js",
            "*.min.css",
            "*.map",
            "dist/**",
            "out/**",
            "build/**"
          ],
          "description": "Glob patterns of files ignored when counting lines added/removed (lockfiles, build output...)."
        },
        "commitboard.serverUrl": {
          "type": "string",
          "default": "https://commitboard-api.zinro.app",
          "description": "Server for the optional CommitBoard Cloud (live team boards). Only contacted after you choose Cloud and sign in. Free local boards never use it."
        },
        "commitboard.cloud.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the optional CommitBoard Cloud (live sync) option. Turn off to use free local boards only."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:bufferutil --external:utf-8-validate --format=cjs --platform=node --target=node18",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:bufferutil --external:utf-8-validate --format=cjs --platform=node --target=node18 --watch",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  },
  "author": {
    "name": "Aryan Goud"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
